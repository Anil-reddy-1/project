# Environment Mode & Ports
NODE_ENV=development
PORT=5000

# PostgreSQL Database Credentials
DB_USER_NAME=postgres
DB_HOST=db
DATABASE_NAME=campusiq
DB_PORT=5432
DB_PASS=your_postgres_password_here

# Redis Cache Credentials
REDIS_PASSWORD=your_redis_password_here
REDIS_URI=redis://:your_redis_password_here@redis:6379


# Firebase Admin SDK Credentials (Optional / Production)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"



# frontend firebase Credentials
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=




VITE_BACKEND_URL=http://localhost:5000/api

