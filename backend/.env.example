# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — B2B Wholesale Marketplace — Express Backend
# SAFE TO COMMIT — all values are blank.
# Copy this to .env and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# NOTE: No FIREBASE_DATABASE_URL — live location tracking uses Firestore, not RTDB.

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PhonePe Payment Gateway (Phase 3)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_API_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=http://localhost:3000/retailer/payment/callback
PHONEPE_WEBHOOK_URL=
# Set to "true" for mock payments (recommended for development/testing)
# Set to "false" to use real PhonePe API
PHONEPE_MOCK_MODE=true

# Order Configuration (Phase 3)
DEFAULT_TAX_PERCENTAGE=0
DEFAULT_DELIVERY_CHARGE=0
ORDER_NUMBER_PREFIX=ORD



# Brevo (Email Service)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Google Maps API (Phase 5C - Route Optimization)
GOOGLE_MAPS_API_KEY=

# Dynamic Pricing (Phase 5C)
SURGE_PRICING_ENABLED=true
BASE_DELIVERY_RATE=15
MAX_SURGE_MULTIPLIER=2.5

# Route Optimization (Phase 5C)
ROUTE_CACHE_TTL_SECONDS=300
MAX_BATCH_SIZE=5

# SMS Gateway — optional fallback (Phase 1+)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
