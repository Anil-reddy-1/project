{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API — B2B Wholesale Marketplace",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "seed:admin": "ts-node --skip-project scripts/seed-admin.ts",
